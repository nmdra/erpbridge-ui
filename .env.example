ERPBRIDGE_BASE_URL=http://localhost:8080
BFF_PORT=8787
VITE_ERPBRIDGE_BASE_URL=http://localhost:8080

# BFF SDK credentials. The Node BFF reads these at startup only.
# Tokens are never returned by BFF endpoints, logged, or persisted.
# ERPBRIDGE_TOKEN=          # global bearer token for all SDK surfaces
# ERPBRIDGE_LOGS_TOKEN=     # optional override for the logs surface
# ERPBRIDGE_METRICS_TOKEN=  # optional override for the metrics surface

# Optional live-test configuration. Supply values only for local,
# disposable servers; never commit real tokens.
# ERPBRIDGE_TEST_SERVER=http://localhost:8080
# ERPBRIDGE_TEST_TOKEN=           # enables authenticated MCP integration/e2e cases
# ERPBRIDGE_TEST_GUARDED_TOOL=    # tool name with allowedRoles, for role-gated REST checks
# ERPBRIDGE_TEST_ROLE=            # role held by the test token identity
